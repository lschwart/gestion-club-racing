<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>INGRESO - RACING LTC</title>
    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background-color: #dee2e6;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            padding: 15px;
        }
        .login-card {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 360px;
            text-align: center;
        }
        .login-card h2 {
            color: #2c3e50;
            margin-bottom: 25px;
            font-size: 1.5rem;
        }
        .form-group {
            margin-bottom: 15px;
            text-align: left;
        }
        .form-group label {
            font-size: 0.8rem;
            font-weight: bold;
            color: #555;
            display: block;
            margin-bottom: 5px;
        }
        .form-group input {
            width: 100%;
            padding: 12px;
            border: 2px solid #ddd;
            border-radius: 8px;
            box-sizing: border-box;
            outline: none;
            font-size: 1rem;
        }
        .form-group input:focus {
            border-color: #3498db;
        }
        .btn-ingresar {
            width: 100%;
            background: #2c3e50;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            font-size: 1rem;
            margin-top: 10px;
        }
        .error-msg {
            color: #e74c3c;
            font-size: 0.85rem;
            margin-bottom: 15px;
            font-weight: bold;
        }
    </style>
</head>
<body>

<div class="login-card">
    <i class="fas fa-lock" style="font-size: 3rem; color: #2c3e50; margin-bottom: 15px;"></i>
    <h2>SISTEMA CLUB RACING LTC</h2>
    
    <% if (typeof error !== 'undefined') { %>
        <div class="error-msg"><%= error %></div>
    <% } %>

    <form action="/login" method="POST">
        <div class="form-group">
            <label>USUARIO</label>
            <input type="text" name="username" required placeholder="Ingresá tu usuario">
        </div>
        <div class="form-group">
            <label>CONTRASEÑA</label>
            <input type="password" name="password" required placeholder="Ingresá tu contraseña">
        </div>
        <button type="submit" class="btn-ingresar">INGRESAR</button>
    </form>
</div>

</body>
</html>
