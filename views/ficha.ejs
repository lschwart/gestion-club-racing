<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ficha de Socio | Club Racing LTC</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --primary: #2c3e50; --secondary: #3498db; --success: #27ae60; --danger: #e74c3c; --bg: #f4f7f6; }
        body { font-family: 'Segoe UI', sans-serif; background: var(--bg); margin: 0; padding: 20px; }
        .container { max-width: 900px; margin: 0 auto; }
        .card { background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-bottom: 20px; }
        .header-ficha { border-top: 6px solid var(--secondary); display: flex; justify-content: space-between; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th { text-align: left; padding: 12px; background: #f8f9fa; color: #666; font-size: 0.85rem; }
        td { padding: 12px; border-bottom: 1px solid #eee; vertical-align: middle; }
        .badge { padding: 4px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: bold; text-transform: uppercase; }
        .btn-pagar { 
            background: var(--success); 
            color: white; 
            border: none; 
            padding: 6px 12px; 
            border-radius: 4px; 
            font-size: 0.8rem; 
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-pagar:hover { background: #219150; }
        
        select.metodo-pago {
            padding: 5px;
            border-radius: 4px;
            border: 1px solid #ccc;
            font-size: 0.8rem;
            outline: none;
            background: white;
        }

        @media print { .no-print { display: none; } body { padding: 0; } .card { box-shadow: none; border: 1px solid #ddd; } }
        
        .status-activo { background: #d4edda; color: #155724; }
        .status-inactivo { background: #f8d7da; color: #721c24; }
        .status-pagado { background: #d4edda; color: #155724; }
        .status-pendiente { background: #ffeaa7; color: #d35400; }

        select {
            font-family: 'Segoe UI', sans-serif;
            color: #444;
        }
        .btn-pagar:hover {
            background: #219150;
            transform: translateY(-1px);
            transition: all 0.2s;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="card header-ficha">
        <div>
            <h1 style="margin:0;"><%= socio.nombre %> <%= socio.apellido %></h1>
            <p style="color: #666; margin: 5px 0;"><strong>DNI:</strong> <%= socio.dni %></p>
            
            <% if (socio.fecha_nacimiento) { 
                const f = new Date(socio.fecha_nacimiento);
                const hoy = new Date();
                let edad = hoy.getUTCFullYear() - f.getUTCFullYear();
                if (hoy.getUTCMonth() < f.getUTCMonth() || (hoy.getUTCMonth() === f.getUTCMonth() && hoy.getUTCDate() < f.getUTCDate())) edad--;
            %>
                <p style="margin: 5px 0;">📅 <strong>Nacimiento:</strong> <%= f.getUTCDate() %>/<%= f.getUTCMonth()+1 %>/<%= f.getUTCFullYear() %> (<%= edad %> años)</p>
            <% } %>

            <span class="badge <%= socio.estado === 'Activo' ? 'status-activo' : 'status-inactivo' %>">
                <%= socio.estado %>
            </span>
        </div>
        <div class="no-print" style="text-align: right;">
            <a href="/" style="text-decoration: none; color: var(--secondary); font-weight: bold;">← Volver</a><br><br>
            <button onclick="window.print()" style="cursor:pointer; padding: 8px 12px; border-radius: 6px; border: 1px solid #ddd; background: white;">
                <i class="fas fa-print"></i> Imprimir
            </button>
        </div>
    </div>

    <div class="card">
        <h3>Historial de Cuotas</h3>
        <table>
            <thead>
                <tr>
                    <th>Período</th>
                    <th>Monto</th>
                    <th>Estado</th>
                    <th>Fecha Pago</th>
                    <th class="no-print">Acción</th>
                </tr>
            </thead>
            <tbody>
                <% if (socio.cuotas && socio.cuotas.length > 0) { %>
                    <% socio.cuotas.forEach(c => { %>
                        <tr>
                            <td><strong><%= c.mes %>/<%= c.anio %></strong></td>
                            <td>$<%= c.monto %></td>
                            <td>
                                <span class="badge <%= c.estado_pago.toUpperCase() === 'PAGADO' ? 'status-pagado' : 'status-pendiente' %>">
                                    <%= c.estado_pago %>
                                </span>
                            </td>
                            <td><%= c.fecha_pago ? new Date(c.fecha_pago).toLocaleDateString('es-AR') : '-' %></td>
                            <td class="no-print">
                                <% if (c.estado_pago.toUpperCase() !== 'PAGADO') { %>
                                    <form action="/registrar-pago" method="POST" style="display: flex; gap: 5px; align-items: center;">
                                        <input type="hidden" name="id_cuota" value="<%= c.id_cuota %>">
                                        <input type="hidden" name="id_socio" value="<%= socio.id_socio %>">
                                        <input type="hidden" name="monto" value="<%= c.monto %>">

                                        <select name="metodo_pago" class="metodo-pago" required>
                                            <option value="Efectivo">Efectivo</option>
                                            <option value="Transferencia">Transferencia</option>
                                        </select>

                                        <button type="submit" class="btn-pagar" 
                                                onclick="return confirm('¿Registrar pago de $<%= c.monto %> para el período <%= c.mes %>/<%= c.anio %>?')">
                                            <i class="fas fa-check"></i> Pagar
                                        </button>
                                    </form>
                                <% } else { %>
                                    <span style="color: #27ae60; font-weight: bold; font-size: 0.9rem;">
                                        <i class="fas fa-check-circle"></i> Al día
                                    </span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="5" style="text-align:center;">No hay cuotas registradas.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

</body>
</html>